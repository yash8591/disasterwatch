# DisasterWatch Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password_here
DB_NAME=disaster_db

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=changeme-replace-with-a-64-char-random-secret-key

# FastAPI
DEBUG=true
